{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://god2.local/schemas/ultimate-live-evidence-binding.schema.json",
  "title":"God2 Ultimate live process/evidence binding",
  "type":"object",
  "required":["SchemaVersion","Status","ValidationScope","SessionId","ProcessId","ProcessCreationTime","ClientArchitecture","ClientFileVersion","ClientSHA256","SessionNonceBound","SessionIdentityRevalidated","ExactIdentity","DetachComplete","SharedTransportComplete","SegmentManifestBound","SegmentCount","SegmentRecordCount","SegmentMergedSHA256","SemanticEventCount","RejectedSemanticEventCount","ProbeDiagnosticCount","ParserReadCount","SerializerWriteCount","HandlerInvocationCount","SemanticEvidenceBound","DeepProbeCandidateMapBound","RecoveryManifestInventoryBound","CaptureCoreEvidencePass","DeepRuntimeVerifiedDomainCount","DeepRuntimeRequiredDomainCount","DeepRuntimePromotionEligible"],
  "properties":{
    "SchemaVersion":{"const":"god2-ultimate-live-evidence-binding-v2"},
    "Status":{"enum":["DEEP_RECOVERY_EVIDENCE_PASS","CAPTURE_CORE_EVIDENCE_PASS_DEEP_RUNTIME_BLOCKED","EvidenceBlocked"]},
    "ValidationScope":{"const":"ExactBuildCaptureCoreAndDeepRuntimeGate"},
    "SessionId":{"type":"string","minLength":1},
    "ProcessId":{"type":"integer","minimum":1},
    "ProcessCreationTime":{"type":"integer","minimum":1},
    "ClientArchitecture":{"const":"x86"},
    "ClientFileVersion":{"const":"1.0.0.1"},
    "ClientSHA256":{"const":"6B127086E0C00014DE26137B4EC482801E06E0724C5C05C64561D7F9FF32BD9B"},
    "SessionNonceBound":{"type":"boolean"},
    "SessionIdentityRevalidated":{"type":"boolean"},
    "ExactIdentity":{"type":"boolean"},
    "DetachComplete":{"type":"boolean"},
    "SharedTransportComplete":{"type":"boolean"},
    "SegmentManifestBound":{"type":"boolean"},
    "SegmentCount":{"type":"integer","minimum":0},
    "SegmentRecordCount":{"type":"integer","minimum":0},
    "SegmentMergedSHA256":{"type":"string","pattern":"^(?:[A-F0-9]{64})?$"},
    "SemanticEventCount":{"type":"integer","minimum":0},
    "RejectedSemanticEventCount":{"type":"integer","minimum":0},
    "ProbeDiagnosticCount":{"type":"integer","minimum":0},
    "ParserReadCount":{"type":"integer","minimum":0},
    "SerializerWriteCount":{"type":"integer","minimum":0},
    "HandlerInvocationCount":{"type":"integer","minimum":0},
    "SemanticEvidenceBound":{"type":"boolean"},
    "DeepProbeCandidateMapBound":{"type":"boolean"},
    "RecoveryManifestInventoryBound":{"type":"boolean"},
    "CaptureCoreEvidencePass":{"type":"boolean"},
    "DeepRuntimeVerifiedDomainCount":{"type":"integer","minimum":0,"maximum":25},
    "DeepRuntimeRequiredDomainCount":{"const":25},
    "DeepRuntimePromotionEligible":{"type":"boolean"}
  },
  "allOf":[
    {
      "if":{"properties":{"Status":{"const":"DEEP_RECOVERY_EVIDENCE_PASS"}},"required":["Status"]},
      "then":{"properties":{"CaptureCoreEvidencePass":{"const":true},"SegmentManifestBound":{"const":true},"SegmentCount":{"minimum":1},"SegmentMergedSHA256":{"pattern":"^[A-F0-9]{64}$"},"DeepRuntimeVerifiedDomainCount":{"const":25},"DeepRuntimePromotionEligible":{"const":true}}}
    },
    {
      "if":{"properties":{"Status":{"const":"CAPTURE_CORE_EVIDENCE_PASS_DEEP_RUNTIME_BLOCKED"}},"required":["Status"]},
      "then":{"properties":{"CaptureCoreEvidencePass":{"const":true},"SegmentManifestBound":{"const":true},"SegmentCount":{"minimum":1},"SegmentMergedSHA256":{"pattern":"^[A-F0-9]{64}$"},"DeepRuntimePromotionEligible":{"const":false}}}
    }
  ],
  "additionalProperties":false
}
