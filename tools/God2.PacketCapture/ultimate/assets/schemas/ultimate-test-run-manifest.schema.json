{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://god2.local/schemas/ultimate-test-run-manifest.schema.json",
  "title": "God2 Ultimate generated test-run manifest",
  "type": "object",
  "required": ["SchemaVersion","RunId","GeneratedAtUtc","Product","ProductVersion","Executable","Source","EvidenceTreeSHA256","Commands","Evidence","Tests","Gates"],
  "properties": {
    "SchemaVersion": {"const":"god2-ultimate-test-run-manifest-v1"},
    "RunId": {"type":"string","pattern":"^[A-Za-z0-9._-]{8,160}$"},
    "GeneratedAtUtc": {"type":"string","format":"date-time"},
    "Product": {"const":"God2 Semantic Recovery Engine"},
    "ProductVersion": {"const":"1.3.0.0"},
    "Executable": {"type":"object","required":["SHA256","SizeBytes","FileVersion","ProductVersion","Architecture"],"properties":{"SHA256":{"$ref":"#/$defs/hash"},"SizeBytes":{"type":"integer","minimum":1},"FileVersion":{"const":"1.3.0.0"},"ProductVersion":{"const":"1.3.0.0"},"Architecture":{"const":"x64"}},"additionalProperties":false},
    "Source": {"type":"object","required":["TreeSHA256","FileCount","Files"],"properties":{"TreeSHA256":{"$ref":"#/$defs/hash"},"FileCount":{"type":"integer","minimum":19},"Files":{"type":"array","minItems":19,"items":{"$ref":"#/$defs/file"}}},"additionalProperties":false},
    "EvidenceTreeSHA256": {"$ref":"#/$defs/hash"},
    "Commands": {"type":"array","minItems":1,"items":{"type":"object","required":["CommandId","Command","WorkingDirectory","StartedAtUtc","CompletedAtUtc","ExitCode","ExpectedExitCode","ExecutableSHA256","SourceTreeSHA256"],"properties":{"CommandId":{"$ref":"#/$defs/id"},"Command":{"type":"string","minLength":1},"WorkingDirectory":{"const":"."},"StartedAtUtc":{"type":"string","format":"date-time"},"CompletedAtUtc":{"type":"string","format":"date-time"},"ExitCode":{"enum":[0,4]},"ExpectedExitCode":{"enum":[0,4]},"ExecutableSHA256":{"$ref":"#/$defs/hash"},"SourceTreeSHA256":{"$ref":"#/$defs/hash"}},"allOf":[{"if":{"properties":{"ExpectedExitCode":{"const":0}},"required":["ExpectedExitCode"]},"then":{"properties":{"ExitCode":{"const":0}}}},{"if":{"properties":{"ExpectedExitCode":{"const":4}},"required":["ExpectedExitCode"]},"then":{"properties":{"ExitCode":{"const":4}}}}],"additionalProperties":false}},
    "Evidence": {"type":"array","minItems":1,"items":{"type":"object","required":["EvidenceId","RootIndex","RelativePath","SizeBytes","SHA256","Kind","CommandId"],"properties":{"EvidenceId":{"$ref":"#/$defs/id"},"RootIndex":{"type":"integer","minimum":1},"RelativePath":{"$ref":"#/$defs/path"},"SizeBytes":{"type":"integer","minimum":0},"SHA256":{"$ref":"#/$defs/hash"},"Kind":{"type":"string","pattern":"^[A-Za-z][A-Za-z0-9]+$"},"CommandId":{"$ref":"#/$defs/id"},"AnalyzerId":{"$ref":"#/$defs/id"},"Architecture":{"enum":["x64","x86"]},"SourceRelativePath":{"$ref":"#/$defs/path"}},"additionalProperties":false}},
    "Tests": {"type":"array","minItems":1,"items":{"type":"object","required":["TestId","GateName","Status","CommandId","EvidenceId"],"properties":{"TestId":{"type":"string","minLength":3,"maxLength":500},"GateName":{"type":"string","pattern":"^[A-Za-z][A-Za-z0-9]+$"},"Status":{"enum":["PASS","FAIL"]},"CommandId":{"$ref":"#/$defs/id"},"EvidenceId":{"$ref":"#/$defs/id"}},"additionalProperties":false}},
    "Gates": {"type":"array","minItems":1,"items":{"type":"object","required":["Name","Status","TestIds","EvidenceIds"],"properties":{"Name":{"type":"string","pattern":"^[A-Za-z][A-Za-z0-9]+$"},"Status":{"enum":["PASS","FAIL"]},"TestIds":{"type":"array","minItems":1,"items":{"type":"string","minLength":3}},"EvidenceIds":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/id"}}},"additionalProperties":false}}
  },
  "$defs": {
    "hash": {"type":"string","pattern":"^[A-F0-9]{64}$"},
    "id": {"type":"string","pattern":"^[A-Za-z0-9._-]{3,160}$"},
    "path": {"type":"string","pattern":"^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"},
    "file": {"type":"object","required":["RelativePath","SizeBytes","SHA256"],"properties":{"RelativePath":{"$ref":"#/$defs/path"},"SizeBytes":{"type":"integer","minimum":0},"SHA256":{"$ref":"#/$defs/hash"}},"additionalProperties":false}
  },
  "additionalProperties": false
}
