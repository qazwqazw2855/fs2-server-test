{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://god2.local/schemas/ultimate-artifact-manifest.schema.json",
  "title":"God2 Ultimate artifact manifest",
  "type":"object",
  "required":["SchemaVersion","Product","ProductVersion","DisplayVersion","Channel","GeneratedAtUtc","FinalEngineeringStatus","AutomatedGateStatus","ExternalLiveGateStatus","Rtx5070Status","AiModelStatus","ArtifactCount","ManifestSelfHashPolicy","ExcludedFromArtifactDigest","Artifacts"],
  "properties":{
    "SchemaVersion":{"const":1},
    "Product":{"const":"God2 Semantic Recovery Engine"},
    "ProductVersion":{"const":"1.3.0.0"},
    "DisplayVersion":{"const":"v1.3.0 Ultimate"},
    "Channel":{"const":"Ultimate Private"},
    "GeneratedAtUtc":{"type":"string","format":"date-time"},
    "FinalEngineeringStatus":{"const":"ULTIMATE_DEEP_RECOVERY_IMPLEMENTATION_COMPLETE_WITH_EXTERNAL_LIVE_GATE_PENDING"},
    "AutomatedGateStatus":{"enum":["PASS","FAIL","EVIDENCE_BLOCKED_INCOMPLETE"]},
    "ExternalLiveGateStatus":{"type":"string","minLength":1},
    "Rtx5070Status":{"type":"string","minLength":1},
    "AiModelStatus":{"const":"EvidenceBlockedModelUnavailable"},
    "ArtifactCount":{"type":"integer","minimum":1},
    "ManifestSelfHashPolicy":{"type":"string","minLength":1},
    "ExcludedFromArtifactDigest":{"type":"array","const":["artifact-sha256.json","artifact-sha256.csv"]},
    "Artifacts":{"type":"array","minItems":1,"items":{"type":"object","required":["RelativePath","SizeBytes","SHA256","Classification","Source"],"properties":{"RelativePath":{"type":"string","minLength":1},"SizeBytes":{"type":"integer","minimum":0},"SHA256":{"type":"string","pattern":"^[A-F0-9]{64}$"},"Classification":{"type":"string","minLength":1},"Source":{"type":"string","minLength":1}},"additionalProperties":false}}
  },
  "additionalProperties":false
}
