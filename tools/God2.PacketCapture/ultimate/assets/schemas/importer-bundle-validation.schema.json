{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://god2.local/schemas/importer-bundle-validation.schema.json",
  "title":"God2 importer native bundle validation",
  "type":"object",
  "required":["schemaVersion","status","sourceZipPath","sourceZipSizeBytes","sourceZipSha256","manifestSha256","manifest","clientBuild","contentValidation","integrityValidatedBeforeStaging","productionDatabaseConnectionAttempted","productionDatabaseMutationAttempted"],
  "properties":{
    "schemaVersion":{"const":"god2-recovery-bundle-validation-v1"},
    "status":{"enum":["PASS","FAIL"]},
    "sourceZipPath":{"type":"string","pattern":"^[^/\\\\:]+\\.zip$"},
    "sourceZipSizeBytes":{"type":"integer","minimum":1},
    "sourceZipSha256":{"type":"string","pattern":"^[A-Fa-f0-9]{64}$"},
    "manifestSha256":{"type":"string","pattern":"^[A-Fa-f0-9]{64}$"},
    "manifest":{"$ref":"ultimate-recovery-bundle-manifest.schema.json"},
    "clientBuild":{"$ref":"#/$defs/clientBuild"},
    "contentValidation":{"$ref":"#/$defs/contentValidation"},
    "integrityValidatedBeforeStaging":{"const":true},
    "productionDatabaseConnectionAttempted":{"const":false},
    "productionDatabaseMutationAttempted":{"const":false},
    "diagnostics":{"type":"array","items":{"type":"string"}}
  },
  "$defs":{
    "clientBuild":{
      "type":"object",
      "required":["executable","architecture","fileVersion","sha256","validationStatus","exactBindingValidated","recoveryAttestationStatus","computedSha256","computedFileVersion","computedArchitecture"],
      "properties":{
        "executable":{"const":"God2_opt.exe"},
        "architecture":{"const":"x86"},
        "fileVersion":{"const":"1.0.0.1"},
        "sha256":{"const":"6B127086E0C00014DE26137B4EC482801E06E0724C5C05C64561D7F9FF32BD9B"},
        "validationStatus":{"const":"ExactClientIdentityComputedAndValidated"},
        "exactBindingValidated":{"const":true},
        "recoveryAttestationStatus":{"const":"ExactRecoveryEventBuildSessionProcessAttested"},
        "computedSha256":{"const":"6B127086E0C00014DE26137B4EC482801E06E0724C5C05C64561D7F9FF32BD9B"},
        "computedFileVersion":{"const":"1.0.0.1"},
        "computedArchitecture":{"const":"x86"}
      },
      "additionalProperties":false
    },
    "contentValidation":{
      "type":"object",
      "required":["jsonDocumentCount","jsonLineCount","authorityValueCount","productionPromotionCount","traditionalChineseDisplayFindingCount","brokenReferenceCount","contentOrphanCount","unknownDropSafetyCount","findings"],
      "properties":{
        "jsonDocumentCount":{"type":"integer","minimum":0},
        "jsonLineCount":{"type":"integer","minimum":0},
        "authorityValueCount":{"type":"integer","minimum":0},
        "productionPromotionCount":{"const":0},
        "traditionalChineseDisplayFindingCount":{"const":0},
        "brokenReferenceCount":{"const":0},
        "contentOrphanCount":{"const":0},
        "unknownDropSafetyCount":{"type":"integer","minimum":0},
        "findings":{"type":"array","items":{"type":"string"}}
      },
      "additionalProperties":false
    }
  },
  "additionalProperties":false
}
