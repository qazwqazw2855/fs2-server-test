        "SchemaVersion":{"const":1},
        "CompletedAtUtc":{"type":"string","format":"date-time"},
        "FinalStatus":{"const":"RTX5070_PHYSICAL_VALIDATION_PASS"},
        "PackageVersion":{"const":"1.3.0"},
        "ProductVersion":{"enum":["v1.3.0 Ultimate","1.3.0 Ultimate","1.3.0"]},
        "PeFileVersion":{"const":"1.3.0.0"},
        "ExecutableSHA256":{"$ref":"#/$defs/sha256"},
        "ObservedGpu":{"const":"NVIDIA GeForce RTX 5070"},
        "PackageIntegrity":{"const":"PASS"},
        "PhysicalGpuExecution":{"const":"PASS"},
        "Equivalence":{"const":"PASS"},
        "CpuAuthority":{"const":"Preserved"},
        "AiModelStatus":{"enum":["EvidenceBlockedModelUnavailable","AI_MODEL_PROVIDER_INFERENCE_VERIFIED"]},
        "ValidationManifestPath":{"const":"validation-manifest.json"},
        "WorkloadMatrixPath":{"const":"ultimate-workload-matrix.json"},
        "ResultIntegrity":{"const":"PASS"}
      },
      "additionalProperties":false
    }
  }
}
