  "$defs":{
    "sha256":{"type":"string","pattern":"^[A-Fa-f0-9]{64}$"},
    "nativeSixteenOperationPass":{
      "type":"object",
      "required":["SchemaVersion","CompletedAtUtc","FinalStatus","EngineeringStatus","PackageVersion","ProductVersion","PeFileVersion","ExecutableSHA256","PackageManifestSHA256","TargetOs","ObservedOsGate","TargetGpu","ObservedGpu","ObservedGpuGate","MaximumCapabilityGate","PackageIntegrity","PhysicalGpuExecution","PhysicalCorrectnessStatus","UltimateWorkloadCount","UltimateGpuVerifiedCount","UltimateGpuImplementationBlockedCount","UltimateStructuredImplementationBlockedCount","UltimateEvidenceBlockedCount","UltimateWorkloadStatus","PerformanceStatus","Equivalence","Benchmark","AutoCrossoverStatus","FullCpuOracleRequired","PositiveCrossoverPossible","ConcurrentBatchExecutionAvailable","BenefitGate","CpuAuthority","AiBackend","AiAcceleration","CaptureOrGameRequired","PersistenceInstalled","CleanupStatus","ResultIntegrity","ElapsedMilliseconds"],
      "properties":{
        "SchemaVersion":{"const":1},
        "CompletedAtUtc":{"type":"string","format":"date-time"},
        "FinalStatus":{"const":"RTX5070_PHYSICAL_VALIDATION_GPU_16_VERIFIED_AI_MODEL_BLOCKED"},
        "EngineeringStatus":{"const":"RTX5070_ULTIMATE_VALIDATION_PACKAGE_READY_FOR_EXTERNAL_RUN"},
        "PackageVersion":{"const":"1.3.0"},
        "ProductVersion":{"enum":["v1.3.0 Ultimate","1.3.0 Ultimate","1.3.0"]},
        "PeFileVersion":{"const":"1.3.0.0"},
        "ExecutableSHA256":{"$ref":"#/$defs/sha256"},
        "PackageManifestSHA256":{"$ref":"#/$defs/sha256"},
        "TargetOs":{"const":"Windows 11"},
        "ObservedOsGate":{"const":"PASS"},
        "TargetGpu":{"const":"NVIDIA GeForce RTX 5070"},
        "ObservedGpu":{"const":"NVIDIA GeForce RTX 5070"},
        "ObservedGpuGate":{"const":"PASS"},
        "MaximumCapabilityGate":{"const":"PASS"},
        "PackageIntegrity":{"const":"PASS"},
        "PhysicalGpuExecution":{"const":"PASS"},
        "PhysicalCorrectnessStatus":{"const":"PASS_TRACE_FEATURE_OPERATION_SPECIFIC_GPU_CPU_EXACT"},
        "UltimateWorkloadCount":{"const":17},
        "UltimateGpuVerifiedCount":{"const":16},
        "UltimateGpuImplementationBlockedCount":{"const":0},
        "UltimateStructuredImplementationBlockedCount":{"const":0},
        "UltimateEvidenceBlockedCount":{"const":1},
        "UltimateWorkloadStatus":{"const":"16 GPU VERIFIED; 0 STRUCTURED GPU IMPLEMENTATION BLOCKED; 1 MODEL BLOCKED"},
        "PerformanceStatus":{"const":"TRACE_FEATURE_TIMING_CURVE_MEASURED;16_OPERATION_EQUIVALENCE_MEASURED;AI_MODEL_BLOCKED"},
        "Equivalence":{"const":"PASS_TRACE_FEATURE_GPU_CPU_EXACT"},
        "Benchmark":{"const":"PASS_TRACE_FEATURE_OPERATION_SPECIFIC_MEASUREMENT"},
        "AutoCrossoverStatus":{"const":"NoPositiveCrossoverFullCpuOracleRequired"},
        "FullCpuOracleRequired":{"const":true},
        "PositiveCrossoverPossible":{"const":false},
        "ConcurrentBatchExecutionAvailable":{"const":true},
        "BenefitGate":{"const":"PASS_CONTRACT_16_GPU_IMPLEMENTED_0_STRUCTURED_BLOCKED_1_MODEL_BLOCKED"},
        "CpuAuthority":{"const":"Preserved"},
        "AiBackend":{"const":"EvidenceBlockedModelUnavailable"},
        "AiAcceleration":{"const":"EvidenceBlockedModelUnavailable"},
        "CaptureOrGameRequired":{"const":false},
        "PersistenceInstalled":{"const":false},
        "CleanupStatus":{"const":"PASS"},
        "ResultIntegrity":{"const":"PASS"},
        "ElapsedMilliseconds":{"type":"integer","minimum":0}
      },
      "additionalProperties":false
    },
    "futureOperationSpecificPass":{
      "type":"object",
      "required":["SchemaVersion","CompletedAtUtc","FinalStatus","PackageVersion","ProductVersion","PeFileVersion","ExecutableSHA256","ObservedGpu","PackageIntegrity","PhysicalGpuExecution","Equivalence","CpuAuthority","AiModelStatus","ValidationManifestPath","WorkloadMatrixPath","ResultIntegrity"],
