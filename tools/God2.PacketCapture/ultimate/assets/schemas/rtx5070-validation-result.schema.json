{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://god2.local/schemas/rtx5070-validation-result.schema.json",
  "title":"God2 RTX 5070 Ultimate validation summary",
  "type":"object",
  "properties":{
    "SchemaVersion":{},"CompletedAtUtc":{},"FinalStatus":{},"EngineeringStatus":{},"PackageVersion":{},
    "ProductVersion":{},"PeFileVersion":{},"ExecutableSHA256":{},"PackageManifestSHA256":{},
    "TargetOs":{},"ObservedOsGate":{},"TargetGpu":{},"ObservedGpu":{},"ObservedGpuGate":{},
    "MaximumCapabilityGate":{},"PackageIntegrity":{},"PhysicalGpuExecution":{},"PhysicalCorrectnessStatus":{},
    "UltimateWorkloadCount":{},"UltimateGpuVerifiedCount":{},"UltimateGpuImplementationBlockedCount":{},"UltimateStructuredImplementationBlockedCount":{},
    "UltimateEvidenceBlockedCount":{},"UltimateWorkloadStatus":{},"PerformanceStatus":{},"Equivalence":{},
    "Benchmark":{},"AutoCrossoverStatus":{},"FullCpuOracleRequired":{},"PositiveCrossoverPossible":{},"ConcurrentBatchExecutionAvailable":{},"BenefitGate":{},"CpuAuthority":{},
    "AiBackend":{},"AiAcceleration":{},"AiModelStatus":{},"CaptureOrGameRequired":{},"PersistenceInstalled":{},
    "CleanupStatus":{},"ResultIntegrity":{},"ElapsedMilliseconds":{},"ValidationManifestPath":{},"WorkloadMatrixPath":{}
