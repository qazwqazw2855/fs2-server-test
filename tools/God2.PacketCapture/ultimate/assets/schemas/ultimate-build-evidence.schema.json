{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://god2.local/schemas/ultimate-build-evidence.schema.json",
  "title":"God2 Ultimate build evidence summary",
  "type":"object",
  "required":["SchemaVersion","GeneratedAtUtc","Product","ProductVersion","PackagedExecutableSHA256","TestRunManifestSHA256","SourceTreeSHA256","EvidenceTreeSHA256","AutomatedGateStatus","ExternalLiveGateStatus","LiveRunnerContractStatus","Rtx5070Status","Rtx5070ExternalAttestationRequired","Rtx5070ValidatedResultSHA256","Rtx5070ExternalAuditSHA256","Rtx5070ExternalAuditScope","Rtx5070ExternalAuditPromotedUltimateGate","AiModelStatus","FinalEngineeringStatus","InputReportCount","JsonReportCount","JsonParseFailureCount","Gates","DoesNotAssert"],
  "properties":{
    "SchemaVersion":{"const":1},
    "GeneratedAtUtc":{"type":"string","format":"date-time"},
    "Product":{"const":"God2 Semantic Recovery Engine"},
    "ProductVersion":{"const":"1.3.0.0"},
    "PackagedExecutableSHA256":{"type":"string","pattern":"^[A-F0-9]{64}$"},
    "TestRunManifestSHA256":{"type":"string","pattern":"^[A-F0-9]{64}$"},
    "SourceTreeSHA256":{"type":"string","pattern":"^[A-F0-9]{64}$"},
    "EvidenceTreeSHA256":{"type":"string","pattern":"^[A-F0-9]{64}$"},
    "AutomatedGateStatus":{"enum":["PASS","FAIL","EVIDENCE_BLOCKED_INCOMPLETE"]},
    "ExternalLiveGateStatus":{"type":"string","minLength":1},
    "LiveRunnerContractStatus":{"enum":["PASS","EvidenceBlockedNativeLiveEntrypointContractMissing"]},
    "Rtx5070Status":{"type":"string","minLength":1},
    "Rtx5070ExternalAttestationRequired":{"const":true},
    "Rtx5070ValidatedResultSHA256":{"type":["string","null"],"pattern":"^[A-F0-9]{64}$"},
    "Rtx5070ExternalAuditSHA256":{"type":["string","null"],"pattern":"^[A-F0-9]{64}$"},
    "Rtx5070ExternalAuditScope":{"type":["string","null"]},
    "Rtx5070ExternalAuditPromotedUltimateGate":{"type":"boolean"},
    "AiModelStatus":{"const":"EvidenceBlockedModelUnavailable"},
    "FinalEngineeringStatus":{"const":"ULTIMATE_DEEP_RECOVERY_IMPLEMENTATION_COMPLETE_WITH_EXTERNAL_LIVE_GATE_PENDING"},
    "InputReportCount":{"type":"integer","minimum":1},
    "JsonReportCount":{"type":"integer","minimum":0},
    "JsonParseFailureCount":{"const":0},
    "Gates":{"type":"array","minItems":1,"items":{"type":"object","required":["Name","Status","Evidence"],"properties":{"Name":{"type":"string","minLength":1},"Status":{"enum":["PASS","FAIL","EVIDENCE_BLOCKED_MISSING"]},"Evidence":{"type":"string","minLength":1}},"additionalProperties":false}},
    "DoesNotAssert":{"type":"array","items":{"type":"string"}}
  },
  "additionalProperties":false
}
