{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://god2.local/schemas/rtx5070-workload-matrix.schema.json",
  "title":"God2 RTX 5070 useful Ultimate workload matrix",
  "type":"object",
  "properties":{
    "SchemaVersion":{},"CollectedAtUtc":{},"Status":{},"ExecutableSHA256":{},"PackageManifestSHA256":{},
    "WorkloadCount":{},"GpuVerifiedCount":{},"GpuImplementationBlockedCount":{},"StructuredImplementationBlockedCount":{},"EvidenceBlockedCount":{},
    "AiInferenceStatus":{},"CpuAuthority":{},"ConcurrentBatchExecutionAvailable":{},"PeakInflightBatches":{},"Workloads":{},"OperationCount":{},"Operations":{}
  },
  "oneOf":[
    {"$ref":"#/$defs/nativeSixteenOperationMatrix"},
    {"$ref":"#/$defs/futureOperationSpecificPassMatrix"}
  ],
  "additionalProperties":false,
  "$defs":{
    "sha256":{"type":"string","pattern":"^[A-Fa-f0-9]{64}$"},
    "fnvDigest":{"type":"string","pattern":"^FNV1A64:[A-F0-9]{16}$"},
    "counter":{"type":"integer","minimum":0},
    "nativeSixteenOperation":{
      "type":"object",
      "required":["OperationClass","Algorithm","NormalizedInputContract","CandidateOutputContract","WorkloadScope","Status","ImplementationStatus","ModelStatus","NormalizedInputDigest","GpuPrimitiveDigest","CpuPrimitiveDigest","CpuOnlyOutputDigest","GpuCandidateDigest","AuthoritativeOutputDigest","GpuCandidateExecuted","GpuPrimitiveExtractionExecuted","OperationSpecificGpuImplementationAvailable","CpuAuthorityPreserved","PrimitiveEquivalent","OperationSpecificCandidateEquivalent","CpuAuthorityOutputStable","InputRecords","InputBytes","GpuBatches","GpuKernelLaunches","GpuProcessedRecords","CpuVerificationRecords","MismatchCount","DevicePoolAllocations","DevicePoolReuses","PinnedPoolAllocations","PinnedPoolReuses","AsyncTransfers","ConfiguredStreams","PeakInflightBatches","PeakGpuMemoryBytes","PeakPinnedHostMemoryBytes","FallbackOccurred","FallbackReason"],
      "properties":{
        "OperationClass":{"enum":["TraceFeatureExtraction","CrossSessionCorrelation","ParserFieldPatternMatching","FunctionClustering","ObjectClustering","ClassLayoutScoring","RegistryScoring","HeapGraphSimilarity","ValueFlowAggregation","TaintGraphBatch","SemanticEdgeScoring","ApproximateNearestNeighbor","SequenceMining","FsmScoring","FormulaBatchEvaluation","ReplayStateComparison","AiInference"]},
        "Algorithm":{"type":"string","minLength":1},
        "NormalizedInputContract":{"type":"string","minLength":1},
        "CandidateOutputContract":{"type":"string","minLength":1},
        "WorkloadScope":{"enum":["IndependentRecordBatch","StructuredCrossRecordOrGraphBatch","ExternalVerifiedModelProvider"]},
        "Status":{"enum":["PASS_OPERATION_SPECIFIC_GPU_CPU_EXACT","EvidenceBlockedModelUnavailable"]},
        "ImplementationStatus":{"enum":["OperationSpecificGpuCandidateVerified","EvidenceBlockedModelUnavailable"]},
        "ModelStatus":{"enum":["NotApplicable","EvidenceBlockedModelUnavailable"]},
        "NormalizedInputDigest":{"$ref":"#/$defs/fnvDigest"},
        "GpuPrimitiveDigest":{"oneOf":[{"$ref":"#/$defs/fnvDigest"},{"const":"NOT_RUN_NO_VERIFIED_MODEL"}]},
        "CpuPrimitiveDigest":{"oneOf":[{"$ref":"#/$defs/fnvDigest"},{"const":"NOT_COMPARED"}]},
        "CpuOnlyOutputDigest":{"$ref":"#/$defs/fnvDigest"},
        "GpuCandidateDigest":{"oneOf":[{"$ref":"#/$defs/fnvDigest"},{"const":"NOT_RUN_NO_VERIFIED_MODEL"}]},
        "AuthoritativeOutputDigest":{"$ref":"#/$defs/fnvDigest"},
        "GpuCandidateExecuted":{"type":"boolean"},
        "GpuPrimitiveExtractionExecuted":{"type":"boolean"},
        "OperationSpecificGpuImplementationAvailable":{"type":"boolean"},
        "CpuAuthorityPreserved":{"const":true},
        "PrimitiveEquivalent":{"const":true},
        "OperationSpecificCandidateEquivalent":{"type":"boolean"},
        "CpuAuthorityOutputStable":{"const":true},
        "InputRecords":{"type":"integer","minimum":1},
        "InputBytes":{"type":"integer","minimum":1},
        "GpuBatches":{"$ref":"#/$defs/counter"},
        "GpuKernelLaunches":{"$ref":"#/$defs/counter"},
        "GpuProcessedRecords":{"$ref":"#/$defs/counter"},
        "CpuVerificationRecords":{"type":"integer","minimum":1},
        "MismatchCount":{"const":0},
        "DevicePoolAllocations":{"$ref":"#/$defs/counter"},
        "DevicePoolReuses":{"$ref":"#/$defs/counter"},
        "PinnedPoolAllocations":{"$ref":"#/$defs/counter"},
        "PinnedPoolReuses":{"$ref":"#/$defs/counter"},
        "AsyncTransfers":{"$ref":"#/$defs/counter"},
        "ConfiguredStreams":{"type":"integer","minimum":0},
        "PeakInflightBatches":{"type":"integer","minimum":0},
        "PeakGpuMemoryBytes":{"$ref":"#/$defs/counter"},
        "PeakPinnedHostMemoryBytes":{"$ref":"#/$defs/counter"},
        "FallbackOccurred":{"type":"boolean"},
        "FallbackReason":{"type":"string","minLength":1}
      },
      "allOf":[
        {
          "if":{"properties":{"OperationClass":{"const":"AiInference"}},"required":["OperationClass"]},
          "then":{"properties":{"WorkloadScope":{"const":"ExternalVerifiedModelProvider"},"Status":{"const":"EvidenceBlockedModelUnavailable"},"ImplementationStatus":{"const":"EvidenceBlockedModelUnavailable"},"ModelStatus":{"const":"EvidenceBlockedModelUnavailable"},"GpuPrimitiveDigest":{"const":"NOT_RUN_NO_VERIFIED_MODEL"},"CpuPrimitiveDigest":{"const":"NOT_COMPARED"},"GpuCandidateDigest":{"const":"NOT_RUN_NO_VERIFIED_MODEL"},"GpuCandidateExecuted":{"const":false},"GpuPrimitiveExtractionExecuted":{"const":false},"OperationSpecificGpuImplementationAvailable":{"const":false},"OperationSpecificCandidateEquivalent":{"const":false},"GpuBatches":{"const":0},"GpuKernelLaunches":{"const":0},"GpuProcessedRecords":{"const":0},"PeakInflightBatches":{"const":0}}}
        },
        {
          "if":{"properties":{"OperationClass":{"enum":["TraceFeatureExtraction","CrossSessionCorrelation","ParserFieldPatternMatching","FunctionClustering","ObjectClustering","ClassLayoutScoring","RegistryScoring","HeapGraphSimilarity","ValueFlowAggregation","TaintGraphBatch","SemanticEdgeScoring","ApproximateNearestNeighbor","SequenceMining","FsmScoring","FormulaBatchEvaluation","ReplayStateComparison"]}},"required":["OperationClass"]},
          "then":{"properties":{"WorkloadScope":{"enum":["IndependentRecordBatch","StructuredCrossRecordOrGraphBatch"]},"Status":{"const":"PASS_OPERATION_SPECIFIC_GPU_CPU_EXACT"},"ImplementationStatus":{"const":"OperationSpecificGpuCandidateVerified"},"ModelStatus":{"const":"NotApplicable"},"GpuPrimitiveDigest":{"$ref":"#/$defs/fnvDigest"},"CpuPrimitiveDigest":{"$ref":"#/$defs/fnvDigest"},"GpuCandidateDigest":{"$ref":"#/$defs/fnvDigest"},"GpuCandidateExecuted":{"const":true},"GpuPrimitiveExtractionExecuted":{"const":true},"OperationSpecificGpuImplementationAvailable":{"const":true},"OperationSpecificCandidateEquivalent":{"const":true},"GpuBatches":{"type":"integer","minimum":1},"GpuKernelLaunches":{"type":"integer","minimum":2},"GpuProcessedRecords":{"type":"integer","minimum":1},"ConfiguredStreams":{"type":"integer","minimum":2},"PeakInflightBatches":{"type":"integer","minimum":2}}}
        }
      ],
      "additionalProperties":false
    },
    "nativeSixteenOperationMatrix":{
      "type":"object",
      "required":["SchemaVersion","CollectedAtUtc","Status","ExecutableSHA256","PackageManifestSHA256","WorkloadCount","GpuVerifiedCount","GpuImplementationBlockedCount","StructuredImplementationBlockedCount","EvidenceBlockedCount","AiInferenceStatus","CpuAuthority","ConcurrentBatchExecutionAvailable","PeakInflightBatches","Workloads"],
      "properties":{
        "SchemaVersion":{"const":1},
        "CollectedAtUtc":{"type":"string","format":"date-time"},
        "Status":{"const":"GPU_16_WORKLOADS_VERIFIED_AI_MODEL_BLOCKED"},
        "ExecutableSHA256":{"$ref":"#/$defs/sha256"},
        "PackageManifestSHA256":{"$ref":"#/$defs/sha256"},
        "WorkloadCount":{"const":17},
        "GpuVerifiedCount":{"const":16},
        "GpuImplementationBlockedCount":{"const":0},
        "StructuredImplementationBlockedCount":{"const":0},
        "EvidenceBlockedCount":{"const":1},
        "AiInferenceStatus":{"const":"EvidenceBlockedModelUnavailable"},
        "CpuAuthority":{"const":"Preserved"},
        "ConcurrentBatchExecutionAvailable":{"const":true},
        "PeakInflightBatches":{"type":"integer","minimum":2},
        "Workloads":{
          "type":"array","minItems":17,"maxItems":17,
          "prefixItems":[
            {"allOf":[{"$ref":"#/$defs/nativeSixteenOperation"},{"properties":{"OperationClass":{"const":"TraceFeatureExtraction"}},"required":["OperationClass"]}]},
            {"allOf":[{"$ref":"#/$defs/nativeSixteenOperation"},{"properties":{"OperationClass":{"const":"CrossSessionCorrelation"}},"required":["OperationClass"]}]},
            {"allOf":[{"$ref":"#/$defs/nativeSixteenOperation"},{"properties":{"OperationClass":{"const":"ParserFieldPatternMatching"}},"required":["OperationClass"]}]},
            {"allOf":[{"$ref":"#/$defs/nativeSixteenOperation"},{"properties":{"OperationClass":{"const":"FunctionClustering"}},"required":["OperationClass"]}]},
            {"allOf":[{"$ref":"#/$defs/nativeSixteenOperation"},{"properties":{"OperationClass":{"const":"ObjectClustering"}},"required":["OperationClass"]}]},
            {"allOf":[{"$ref":"#/$defs/nativeSixteenOperation"},{"properties":{"OperationClass":{"const":"ClassLayoutScoring"}},"required":["OperationClass"]}]},
            {"allOf":[{"$ref":"#/$defs/nativeSixteenOperation"},{"properties":{"OperationClass":{"const":"RegistryScoring"}},"required":["OperationClass"]}]},
            {"allOf":[{"$ref":"#/$defs/nativeSixteenOperation"},{"properties":{"OperationClass":{"const":"HeapGraphSimilarity"}},"required":["OperationClass"]}]},
            {"allOf":[{"$ref":"#/$defs/nativeSixteenOperation"},{"properties":{"OperationClass":{"const":"ValueFlowAggregation"}},"required":["OperationClass"]}]},
            {"allOf":[{"$ref":"#/$defs/nativeSixteenOperation"},{"properties":{"OperationClass":{"const":"TaintGraphBatch"}},"required":["OperationClass"]}]},
            {"allOf":[{"$ref":"#/$defs/nativeSixteenOperation"},{"properties":{"OperationClass":{"const":"SemanticEdgeScoring"}},"required":["OperationClass"]}]},
            {"allOf":[{"$ref":"#/$defs/nativeSixteenOperation"},{"properties":{"OperationClass":{"const":"ApproximateNearestNeighbor"}},"required":["OperationClass"]}]},
            {"allOf":[{"$ref":"#/$defs/nativeSixteenOperation"},{"properties":{"OperationClass":{"const":"SequenceMining"}},"required":["OperationClass"]}]},
            {"allOf":[{"$ref":"#/$defs/nativeSixteenOperation"},{"properties":{"OperationClass":{"const":"FsmScoring"}},"required":["OperationClass"]}]},
            {"allOf":[{"$ref":"#/$defs/nativeSixteenOperation"},{"properties":{"OperationClass":{"const":"FormulaBatchEvaluation"}},"required":["OperationClass"]}]},
            {"allOf":[{"$ref":"#/$defs/nativeSixteenOperation"},{"properties":{"OperationClass":{"const":"ReplayStateComparison"}},"required":["OperationClass"]}]},
            {"allOf":[{"$ref":"#/$defs/nativeSixteenOperation"},{"properties":{"OperationClass":{"const":"AiInference"}},"required":["OperationClass"]}]}
          ],
          "items":false
        }
      },
      "additionalProperties":false
    },
    "futureOperation":{
      "type":"object",
      "required":["OperationClass","Status","WorkloadSemantics","GpuExecuted","OperationSpecificGpuImplementationAvailable","GpuKernelLaunches","MismatchCount","BackendErrors","DroppedEvidence","WorkloadDigest","ProviderInferenceExecuted","CpuAuthority"],
      "properties":{
        "OperationClass":{"enum":["TraceFeatureExtraction","CrossSessionCorrelation","ParserFieldPatternMatching","FunctionClustering","ObjectClustering","ClassLayoutScoring","RegistryScoring","HeapGraphSimilarity","ValueFlowAggregation","TaintGraphBatch","SemanticEdgeScoring","ApproximateNearestNeighbor","SequenceMining","FsmScoring","FormulaBatchEvaluation","ReplayStateComparison","AiInference"]},
        "Status":{"enum":["PASS","EvidenceBlockedModelUnavailable"]},
        "WorkloadSemantics":{"type":"string","minLength":8},
        "GpuExecuted":{"type":"boolean"},
        "OperationSpecificGpuImplementationAvailable":{"type":"boolean"},
        "GpuKernelLaunches":{"type":"integer","minimum":0},
        "GpuProcessedRecords":{"type":"integer","minimum":0},
        "CpuVerificationRecords":{"type":"integer","minimum":0},
        "CpuGpuEquivalent":{"oneOf":[{"type":"boolean"},{"const":"NotEvaluated"}]},
        "MismatchCount":{"const":0},
        "BackendErrors":{"const":0},
        "DroppedEvidence":{"const":0},
        "CpuDigest":{"$ref":"#/$defs/sha256"},
        "GpuDigest":{"$ref":"#/$defs/sha256"},
        "WorkloadDigest":{"$ref":"#/$defs/sha256"},
        "CpuWallMicroseconds":{"$ref":"#/$defs/counter"},
        "GpuComputeMicroseconds":{"$ref":"#/$defs/counter"},
        "H2DMicroseconds":{"$ref":"#/$defs/counter"},
        "D2HMicroseconds":{"$ref":"#/$defs/counter"},
        "SynchronizeMicroseconds":{"$ref":"#/$defs/counter"},
        "CpuVerificationMicroseconds":{"$ref":"#/$defs/counter"},
        "RecordsPerSecond":{"$ref":"#/$defs/counter"},
        "BytesPerSecond":{"$ref":"#/$defs/counter"},
        "GraphEdgesPerSecond":{"$ref":"#/$defs/counter"},
        "PeakRamBytes":{"$ref":"#/$defs/counter"},
        "PeakVramBytes":{"$ref":"#/$defs/counter"},
        "QueueHighWater":{"$ref":"#/$defs/counter"},
        "ProviderInferenceExecuted":{"type":"boolean"},
        "CpuAuthority":{"const":"Preserved"},
        "ModelName":{"type":"string","minLength":1},
        "ModelVersion":{"type":"string","minLength":1},
        "ModelLicense":{"type":"string","minLength":1},
        "ModelSHA256":{"$ref":"#/$defs/sha256"},
        "Authority":{"enum":["HYPOTHESIS"]},
        "BlockedReason":{"const":"EvidenceBlockedModelUnavailable"}
      },
      "allOf":[
        {
          "if":{"properties":{"OperationClass":{"const":"AiInference"},"Status":{"const":"EvidenceBlockedModelUnavailable"}},"required":["OperationClass","Status"]},
          "then":{"required":["Authority","BlockedReason"],"properties":{"ProviderInferenceExecuted":{"const":false},"GpuExecuted":{"const":false},"OperationSpecificGpuImplementationAvailable":{"const":false},"GpuKernelLaunches":{"const":0},"CpuAuthority":{"const":"Preserved"}}},
          "else":{"required":["GpuProcessedRecords","CpuVerificationRecords","CpuGpuEquivalent","CpuDigest","GpuDigest","CpuWallMicroseconds","GpuComputeMicroseconds","H2DMicroseconds","D2HMicroseconds","SynchronizeMicroseconds","CpuVerificationMicroseconds","RecordsPerSecond","BytesPerSecond","GraphEdgesPerSecond","PeakRamBytes","PeakVramBytes","QueueHighWater"],"properties":{"Status":{"const":"PASS"},"GpuExecuted":{"const":true},"OperationSpecificGpuImplementationAvailable":{"const":true},"GpuKernelLaunches":{"type":"integer","minimum":1},"GpuProcessedRecords":{"type":"integer","minimum":1},"CpuVerificationRecords":{"type":"integer","minimum":1},"CpuGpuEquivalent":{"const":true}}}
        },
        {
          "if":{"properties":{"OperationClass":{"const":"AiInference"},"Status":{"const":"PASS"}},"required":["OperationClass","Status"]},
          "then":{"required":["ModelName","ModelVersion","ModelLicense","ModelSHA256"],"properties":{"ProviderInferenceExecuted":{"const":true}}}
        }
      ],
      "additionalProperties":false
    },
    "futureOperationSpecificPassMatrix":{
      "type":"object",
      "required":["SchemaVersion","OperationCount","Operations"],
      "properties":{
        "SchemaVersion":{"const":"god2-rtx5070-ultimate-workload-matrix-v1"},
        "OperationCount":{"const":17},
        "Operations":{"type":"array","minItems":17,"maxItems":17,"items":{"$ref":"#/$defs/futureOperation"}}
      },
      "additionalProperties":false
    }
  }
}
