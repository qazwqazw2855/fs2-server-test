{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://god2.local/schemas/importer-result-manifest.schema.json",
  "title":"God2 importer result manifest",
  "type":"object",
  "required":["schemaVersion","status","algorithm","manifestSelfHashIncluded","entries"],
  "properties":{
    "schemaVersion":{"const":"god2-recovery-import-result-manifest-v1"},
    "status":{"const":"PASS"},
    "algorithm":{"const":"SHA-256"},
    "manifestSelfHashIncluded":{"const":false},
    "entries":{"type":"array","minItems":1,"items":{"type":"object","required":["relativePath","sizeBytes","sha256"],"properties":{"relativePath":{"type":"string","minLength":1},"sizeBytes":{"type":"integer","minimum":0},"sha256":{"type":"string","pattern":"^[A-Fa-f0-9]{64}$"}},"additionalProperties":false}}
  },
  "additionalProperties":false
}
