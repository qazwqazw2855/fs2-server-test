  "$defs": {
    "engineBounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ScanRadiusBytes",
        "MaximumCandidatesPerDomain",
        "SignatureBytes",
        "WritableMemoryScanned"
      ],
      "properties": {
        "ScanRadiusBytes": { "const": 256 },
        "MaximumCandidatesPerDomain": { "const": 4 },
        "SignatureBytes": { "const": 8 },
        "WritableMemoryScanned": { "const": false }
      }
    },
    "confirmedDomain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Domain",
        "Probe",
        "Status",
        "Authority",
        "Candidates",
        "CandidateCount",
        "VerificationStatus"
      ],
      "properties": {
        "Domain": { "enum": ["Network", "Parser", "Serializer", "Handler"] },
        "Probe": {
          "enum": [
            "WinsockTransport",
            "PacketDecode.FrameBoundary",
            "OutboundEnqueue.FrameBuilder",
            "Battle.HandlerRecordLength"
          ]
        },
        "Status": { "enum": ["Active", "CurrentTargetIdentityBlocked"] },
        "Authority": { "enum": ["VERIFIED", "UNKNOWN"] },
        "Candidates": { "type": "array", "minItems": 1, "maxItems": 4 },
        "CandidateCount": { "type": "integer", "minimum": 1, "maximum": 4 },
        "VerificationStatus": {
          "enum": ["PASS", "EvidenceBlockedExactIdentityMismatch"]
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["Status"],
            "properties": { "Status": { "const": "Active" } }
          },
          "then": {
            "properties": {
              "Authority": { "const": "VERIFIED" },
              "VerificationStatus": { "const": "PASS" }
            }
          },
          "else": {
            "properties": {
              "Authority": { "const": "UNKNOWN" },
              "VerificationStatus": { "const": "EvidenceBlockedExactIdentityMismatch" }
            }
          }
        }
      ]
    },
    "candidateOnlyDomain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Domain",
        "Probe",
        "Status",
        "Authority",
        "DiscoveryPlan",
        "Candidates",
        "CandidateCount",
        "VerificationContract",
        "VerificationStatus",
        "InstallationPolicy",
        "SafeNextAction"
      ],
      "properties": {
        "Domain": { "enum": ["Object","Allocation","VTable","Factory","ManagerLookup","Registry","ResourceDecode","Mutation","TaintSeed","FormulaOperand","Quest","Map","Portal","NPC","Monster","Battle","Inventory","Item","Skill","Pet/Mount","Snapshot"] },
        "Probe": { "enum": ["ObjectResolver","AllocationProbe","VTableProbe","FactoryProbe","ManagerLookupProbe","RegistryProbe","ResourceDecodeProbe","MutationProbe","TaintSeedProbe","FormulaOperandProbe","QuestProbe","MapProbe","PortalProbe","NPCProbe","MonsterProbe","BattleProbe","InventoryProbe","ItemProbe","SkillProbe","PetMountProbe","SnapshotProbe"] },
        "Status": { "const": "EvidenceBlockedUnconfirmedProbe" },
        "Authority": { "const": "UNKNOWN" },
        "DiscoveryPlan": { "$ref": "#/$defs/discoveryPlan" },
        "Candidates": {
          "type": "array",
          "maxItems": 4,
          "items": { "$ref": "#/$defs/candidate" }
        },
        "CandidateCount": { "type": "integer", "minimum": 0, "maximum": 4 },
        "VerificationContract": { "$ref": "#/$defs/verificationContract" },
        "VerificationStatus": {
          "enum": [
            "EvidenceBlockedNoExecutableCallCandidate",
            "EvidenceBlockedCandidateRequiresTypedRuntimeVerification"
          ]
        },
        "InstallationPolicy": { "const": "NeverInstallUntilAllVerificationGatesPass" },
        "SafeNextAction": {
          "const": "CollectExactBuildRepeatedTypedRuntimeEvidenceAndVerifyCallingConvention"
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["CandidateCount"],
            "properties": { "CandidateCount": { "const": 0 } }
          },
          "then": {
            "properties": {
              "Candidates": { "maxItems": 0 },
              "VerificationContract": {
                "properties": {
                  "ExecutableSection": { "const": false },
                  "ExactCandidateBytes": { "const": false }
                }
              },
              "VerificationStatus": {
                "const": "EvidenceBlockedNoExecutableCallCandidate"
              }
            }
          },
          "else": {
            "properties": {
              "Candidates": { "minItems": 1 },
              "VerificationContract": {
                "properties": {
                  "ExecutableSection": { "const": true },
                  "ExactCandidateBytes": { "const": true }
                }
              },
              "VerificationStatus": {
                "const": "EvidenceBlockedCandidateRequiresTypedRuntimeVerification"
              }
            }
          }
        },
        {
          "if": { "properties": { "CandidateCount": { "const": 1 } } },
          "then": { "properties": { "Candidates": { "minItems": 1, "maxItems": 1 } } }
        },
        {
          "if": { "properties": { "CandidateCount": { "const": 2 } } },
          "then": { "properties": { "Candidates": { "minItems": 2, "maxItems": 2 } } }
        },
        {
          "if": { "properties": { "CandidateCount": { "const": 3 } } },
          "then": { "properties": { "Candidates": { "minItems": 3, "maxItems": 3 } } }
        },
        {
          "if": { "properties": { "CandidateCount": { "const": 4 } } },
          "then": { "properties": { "Candidates": { "minItems": 4, "maxItems": 4 } } }
        }
      ]
    },
    "discoveryPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "SeedDomain",
        "Strategy",
        "TypedEvidenceRequired",
        "CausalEvidenceRequired"
      ],
      "properties": {
        "SeedDomain": { "enum": ["Parser", "Serializer", "Handler"] },
        "Strategy": { "const": "BoundedDirectCallTargetsFromVerifiedSeed" },
        "TypedEvidenceRequired": { "type": "string", "minLength": 1 },
        "CausalEvidenceRequired": { "type": "string", "minLength": 1 }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "CallsiteRva",
        "TargetRva",
        "DiscoveryProvenance",
        "Signature",
        "SignatureMask",
        "ModuleSection",
        "CallingConventionState",
        "ArgumentContractState",
        "ReturnValueLifetimeState",
        "ThreadContextState",
        "ReentrancyRiskState",
        "Risk",
        "VerificationState",
        "RejectionReason"
      ],
      "properties": {
        "CallsiteRva": { "type": "string", "pattern": "^0x[0-9A-Fa-f]{8}$" },
        "TargetRva": { "type": "string", "pattern": "^0x[0-9A-Fa-f]{8}$" },
        "DiscoveryProvenance": {
          "type": "string",
          "pattern": "^VerifiedSeed:(?:Parser|Serializer|Handler);BoundedExecutableDirectCall$"
        },
        "Signature": {
          "type": "string",
          "pattern": "^[0-9A-F]{2}(?: [0-9A-F]{2}){7}$"
