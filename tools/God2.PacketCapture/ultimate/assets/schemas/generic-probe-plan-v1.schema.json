{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://god2.local/schemas/generic-probe-plan-v1.schema.json",
  "title": "God2 Generic Probe Plan v1 source profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generation", "targets"],
  "properties": {
    "schemaVersion": { "const": "god2-generic-probe-plan-v1" },
    "generation": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "targetId", "candidateId", "functionRva", "expectedBytes",
          "capture", "follow", "stackWords", "consumerSteps",
          "maximumObservations", "domain", "priority", "objectSource"
        ],
        "properties": {
          "targetId": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
          "candidateId": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,47}$" },
          "functionRva": { "type": ["integer", "string"] },
          "expectedBytes": { "type": "string", "pattern": "^[0-9A-Fa-f]{2}( [0-9A-Fa-f]{2}){7}$" },
          "capture": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["ECX", "EDX", "BoundedStack"] }
          },
          "follow": {
            "type": "array",
            "uniqueItems": true,
            "items": { "enum": ["Return", "Caller", "Consumer"] }
          },
          "stackWords": { "type": "integer", "minimum": 0, "maximum": 8 },
          "consumerSteps": { "type": "integer", "minimum": 0, "maximum": 4 },
          "maximumObservations": { "type": "integer", "minimum": 1, "maximum": 1000000 },
          "domain": {
            "enum": [
              "Object", "Allocation", "VTable", "Factory", "ManagerLookup",
              "Registry", "ResourceDecode", "Mutation", "TaintSeed",
              "FormulaOperand", "Quest", "Map", "Portal", "NPC", "Monster",
              "Battle", "Inventory", "Item", "Skill", "Pet/Mount", "Snapshot"
            ]
          },
          "priority": { "enum": ["P0", "P1", "P2", "P3"] },
          "objectSource": { "enum": ["None", "ECX", "EDX", "Stack0"] }
        }
      }
    }
  }
}
