{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://god2.local/schemas/validation-package-manifest.schema.json",
  "title":"God2 portable validation package manifest",
  "type":"object",
  "required":["SchemaVersion","ValidationPackageVersion","Product","ProductVersion","PackageKind","CreatedAtUtc","ManifestSelfHashPolicy","ArtifactCount","Artifacts"],
  "properties":{
    "SchemaVersion":{"const":1},
    "ValidationPackageVersion":{"const":"1.3.0"},
    "Product":{"const":"God2 Semantic Recovery Engine"},
    "ProductVersion":{"const":"1.3.0.0"},
    "PackageKind":{"enum":["live","rtx5070"]},
    "CreatedAtUtc":{"type":"string","format":"date-time"},
    "ManifestSelfHashPolicy":{"const":"ManifestExcludedToAvoidRecursiveDigest"},
    "ArtifactCount":{"type":"integer","minimum":1},
    "Artifacts":{"type":"array","minItems":1,"items":{"type":"object","required":["RelativePath","SizeBytes","SHA256"],"properties":{"RelativePath":{"type":"string","minLength":1},"SizeBytes":{"type":"integer","minimum":0},"SHA256":{"type":"string","pattern":"^[A-F0-9]{64}$"}},"additionalProperties":false}}
  },
  "additionalProperties":false
}
