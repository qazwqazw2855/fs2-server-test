{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["SchemaVersion", "ManifestSelfEntryPolicy", "GeneratedAtUtc", "ReleaseVersion", "ReleaseBytes", "ReleaseSHA256", "LauncherOnly", "DirectClientLaunchAllowed", "ExternalWorkspaceDependencyCount", "ExternalRuntimeScriptDependencyCount", "RuntimePathPolicy", "ManagedFileCount", "Files"],
  "properties": {
    "SchemaVersion": { "const": "god2-deep-contract-portable-package-v2" },
    "ManifestSelfEntryPolicy": { "type": "string", "minLength": 1 },
    "GeneratedAtUtc": { "type": "string", "minLength": 1 },
    "ReleaseVersion": { "const": "1.3.0.0" },
    "ReleaseBytes": { "type": "integer", "minimum": 1 },
    "ReleaseSHA256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
    "LauncherOnly": { "const": true },
    "DirectClientLaunchAllowed": { "const": false },
    "ExternalWorkspaceDependencyCount": { "const": 0 },
    "ExternalRuntimeScriptDependencyCount": { "const": 0 },
    "RuntimePathPolicy": { "const": "$PSScriptRoot_PACKAGE_RELATIVE_ONLY" },
    "ManagedFileCount": { "type": "integer", "minimum": 1 },
    "Files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["Path", "Bytes", "SHA256"],
        "properties": {
          "Path": { "type": "string", "minLength": 1 },
          "Bytes": { "type": "integer", "minimum": 1 },
          "SHA256": { "type": "string", "pattern": "^[0-9A-F]{64}$" }
        }
      }
    }
  }
}
