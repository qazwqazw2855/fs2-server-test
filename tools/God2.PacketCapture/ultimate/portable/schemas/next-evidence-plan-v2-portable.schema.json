{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["SchemaVersion", "GeneratedAtUtc", "Authority", "EvidenceDrivenRotation", "MaximumConcurrentCandidateBreakpoints", "SelectedCandidateCount", "CandidateDomains", "SingleDebuggerAttachDetach", "EvidencePhases", "RequiredCorrelationFields", "Rows", "PromotionEligibleCount", "ActivationAllowedCount", "ConfirmedDeepContractCount", "VerifiedFundamentalDomainCount", "Status"],
  "properties": {
    "SchemaVersion": { "const": "god2-next-evidence-plan-v2-portable" },
    "GeneratedAtUtc": { "type": "string", "minLength": 1 },
    "Authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["AuthorityProfile", "TargetExecutable", "TargetArchitecture", "TargetVersion", "TargetSHA256", "CandidateMapSHA256", "FreshCandidateMapRequired", "CurrentSessionObserved", "HistoricalEvidenceReused", "FixtureOnly", "PromotionEligible"],
      "properties": {
        "AuthorityProfile": { "const": "CurrentOfficialClientLive" },
        "TargetExecutable": { "const": "God2_opt.exe" },
        "TargetArchitecture": { "const": "x86" },
        "TargetVersion": { "const": "1.0.0.1" },
        "TargetSHA256": { "const": "6B127086E0C00014DE26137B4EC482801E06E0724C5C05C64561D7F9FF32BD9B" },
        "CandidateMapSHA256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
        "FreshCandidateMapRequired": { "const": true },
        "CurrentSessionObserved": { "const": true },
        "HistoricalEvidenceReused": { "const": false },
        "FixtureOnly": { "const": false },
        "PromotionEligible": { "const": false }
      }
    },
    "EvidenceDrivenRotation": { "const": true },
    "MaximumConcurrentCandidateBreakpoints": { "const": 2 },
    "SelectedCandidateCount": { "const": 2 },
    "CandidateDomains": { "type": "array", "minItems": 2, "maxItems": 2 },
    "SingleDebuggerAttachDetach": { "const": true },
    "EvidencePhases": { "type": "array", "minItems": 1 },
    "RequiredCorrelationFields": { "type": "array", "minItems": 4 },
    "Rows": { "type": "array", "minItems": 2, "maxItems": 2 },
    "PromotionEligibleCount": { "const": 0 },
    "ActivationAllowedCount": { "const": 0 },
    "ConfirmedDeepContractCount": { "const": 0 },
    "VerifiedFundamentalDomainCount": { "const": 0 },
    "Status": { "const": "READY_FOR_EXTERNAL_LIVE_EVIDENCE" }
  }
}
