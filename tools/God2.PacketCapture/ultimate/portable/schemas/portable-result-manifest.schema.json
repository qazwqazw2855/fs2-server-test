{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["SchemaVersion", "ManifestSelfEntryPolicy", "GeneratedAtUtc", "SessionId", "AuthorityProfile", "ManagedFileCount", "PromotionEligibleCount", "ActivationAllowedCount", "ConfirmedDeepContractCount", "VerifiedFundamentalDomainCount", "Files"],
  "properties": {
    "SchemaVersion": { "const": "god2-deep-contract-portable-result-v1" },
    "ManifestSelfEntryPolicy": { "type": "string", "minLength": 1 },
    "GeneratedAtUtc": { "type": "string", "minLength": 1 },
    "SessionId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,100}$" },
    "AuthorityProfile": { "const": "CurrentOfficialClientLive" },
    "ManagedFileCount": { "type": "integer", "minimum": 1 },
    "PromotionEligibleCount": { "const": 0 },
    "ActivationAllowedCount": { "const": 0 },
    "ConfirmedDeepContractCount": { "const": 0 },
    "VerifiedFundamentalDomainCount": { "const": 0 },
    "Files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["Path", "Bytes", "SHA256", "SessionId", "AuthorityProfile"],
        "properties": {
          "Path": { "type": "string", "minLength": 1 },
          "Bytes": { "type": "integer", "minimum": 0 },
          "SHA256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
          "SessionId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,100}$" },
          "AuthorityProfile": { "const": "CurrentOfficialClientLive" }
        }
      }
    }
  }
}
