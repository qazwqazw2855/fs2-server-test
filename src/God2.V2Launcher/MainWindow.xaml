<Window x:Class="God2.V2Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="仙界傳 Rework"
        Width="1180"
        Height="720"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#101923">

    <Window.Resources>

        <!-- 古風中文字體：依 Windows 實際存在字型自動 fallback -->
        <FontFamily x:Key="TitleFont">
            STKaiti, DFKai-SB, KaiTi, Microsoft JhengHei
        </FontFamily>

        <FontFamily x:Key="UiFont">
            Microsoft JhengHei UI, Microsoft JhengHei
        </FontFamily>

        <!-- 上方視窗按鈕 -->
        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFF7E7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BG"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BG"
                                        Property="Background"
                                        Value="#30FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 底部文字按鈕 -->
        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#FFF8E8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="MenuBG"
                                CornerRadius="6"
                                Background="Transparent"
                                Padding="12,8">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MenuBG"
                                        Property="Background"
                                        Value="#20FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 正式金色開始遊戲 -->
        <Style x:Key="StartButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Grid>

                            <!-- 外部金光 -->
                            <Border x:Name="Glow"
                                    Margin="2"
                                    CornerRadius="9"
                                    Background="#35F5C96B">
                                <Border.Effect>
                                    <DropShadowEffect
                                        Color="#F1C76D"
                                        BlurRadius="15"
                                        ShadowDepth="0"
                                        Opacity="0.45"/>
                                </Border.Effect>
                            </Border>

                            <!-- 主體 -->
                            <Border x:Name="Body"
                                    Margin="6"
                                    CornerRadius="7"
                                    BorderBrush="#FFE5A0"
                                    BorderThickness="2">

                                <Border.Background>
                                    <LinearGradientBrush
                                        StartPoint="0,0"
                                        EndPoint="0,1">
                                        <GradientStop Color="#FFF1BD"
                                                      Offset="0"/>
                                        <GradientStop Color="#EBC36B"
                                                      Offset="0.45"/>
                                        <GradientStop Color="#B97B28"
                                                      Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>

                                <Grid>

                                    <!-- 內金框 -->
                                    <Border Margin="5"
                                            CornerRadius="4"
                                            BorderBrush="#75FFF3C5"
                                            BorderThickness="1"/>

                                    <!-- 左裝飾 -->
                                    <TextBlock Text="◆"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center"
                                               Margin="17,0,0,0"
                                               FontSize="15"
                                               Foreground="#80511F"/>

                                    <!-- 右裝飾 -->
                                    <TextBlock Text="◆"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Margin="0,0,17,0"
                                               FontSize="15"
                                               Foreground="#80511F"/>

                                    <ContentPresenter
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>

                                </Grid>
                            </Border>

                        </Grid>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Glow"
                                        Property="Background"
                                        Value="#90FFE19A"/>
                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="Body"
                                        Property="Opacity"
                                        Value="0.78"/>
                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="Body"
                                        Property="Opacity"
                                        Value="0.42"/>
                                <Setter TargetName="Glow"
                                        Property="Opacity"
                                        Value="0.25"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>


    <Grid>

        <!-- =====================================================
             定稿背景
             左上仙界傳 / REWORK 已經在圖片裡，不再重畫
             ===================================================== -->

        <Image Source="/God2V2Launcher;component/Assets/launcher-final.png"
               Stretch="UniformToFill"/>


        <!-- =====================================================
             上方透明操作區
             ===================================================== -->

        <Border Height="54"
                VerticalAlignment="Top"
                Background="Transparent"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

            <Grid>

                <!-- 留空，避免蓋住背景左上 Logo -->

                <StackPanel HorizontalAlignment="Right"
                            Orientation="Horizontal">

                    <Button Width="48"
                            Height="54"
                            Content="—"
                            Style="{StaticResource WindowButton}"
                            Click="Minimize_Click"/>

                    <Button Width="48"
                            Height="54"
                            Content="×"
                            FontSize="28"
                            Style="{StaticResource WindowButton}"
                            Click="Close_Click"/>

                </StackPanel>

            </Grid>

        </Border>


        <!-- =====================================================
             右側仙箋公告
             ===================================================== -->

        <Border Width="350"
                Height="385"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,92,32,0"
                CornerRadius="7"
                BorderThickness="2"
                BorderBrush="#D6B66A"
                Background="#F2FFFDF6">

            <Border.Effect>
                <DropShadowEffect
                    Color="#172737"
                    BlurRadius="17"
                    ShadowDepth="5"
                    Opacity="0.38"/>
            </Border.Effect>

            <Grid>

                <!-- 四角裝飾 -->
                <TextBlock Text="⌜"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Margin="8,3,0,0"
                           FontSize="27"
                           Foreground="#C59C4B"/>

                <TextBlock Text="⌝"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Top"
                           Margin="0,3,8,0"
                           FontSize="27"
                           Foreground="#C59C4B"/>

                <TextBlock Text="⌞"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Bottom"
                           Margin="8,0,0,3"
                           FontSize="27"
                           Foreground="#C59C4B"/>

                <TextBlock Text="⌟"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Bottom"
                           Margin="0,0,8,3"
                           FontSize="27"
                           Foreground="#C59C4B"/>


                <StackPanel Margin="29,25">

                    <TextBlock Text="最新公告"
                               FontFamily="{StaticResource TitleFont}"
                               FontSize="29"
                               FontWeight="Bold"
                               Foreground="#38251A"/>

                    <TextBlock Text="NEWS &amp; NOTICE"
                               FontFamily="Georgia"
                               FontSize="10"
                               Foreground="#9A8A79"
                               Margin="3,1,0,0"/>

                    <Border Height="1"
                            Background="#A99A8878"
                            Margin="0,15,0,0"/>


                    <TextBlock Text="God2 Rework"
                               Margin="0,20,0,0"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#282828"/>

                    <TextBlock Text="全新伺服器核心開發中。"
                               Margin="0,12,0,0"
                               FontFamily="{StaticResource TitleFont}"
                               FontSize="15"
                               Foreground="#50463F"/>

                    <TextBlock Text="原版遊戲客戶端相容性測試進行中。"
                               Margin="0,8,0,0"
                               FontFamily="{StaticResource TitleFont}"
                               FontSize="14"
                               Foreground="#71675F"/>


                    <!-- Server Status -->
                    <Border Height="49"
                            Margin="0,23,0,0"
                            CornerRadius="6"
                            Background="#E92B3B49"
                            BorderBrush="#405F7080"
                            BorderThickness="1">

                        <Grid Margin="15,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Ellipse Width="10"
                                     Height="10"
                                     Fill="#46E889"
                                     VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="1"
                                       Text="Rework"
                                       FontFamily="{StaticResource UiFont}"
                                       FontSize="14"
                                       Foreground="#FFF9ED"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="2"
                                       Text="ONLINE"
                                       FontFamily="Georgia"
                                       FontSize="14"
                                       Foreground="#52E88B"
                                       VerticalAlignment="Center"/>

                        </Grid>

                    </Border>

                </StackPanel>

            </Grid>

        </Border>


        <!-- =====================================================
             底部半透明控制列
             ===================================================== -->

        <Border Height="98"
                VerticalAlignment="Bottom"
                Background="#E5182D40">

            <Grid Margin="32,0,18,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="135"/>
                    <ColumnDefinition Width="135"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="255"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="285"/>
                </Grid.ColumnDefinitions>


                <!-- 遊戲設定 -->

                <Button Grid.Column="0"
                        Style="{StaticResource MenuButton}">

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="⚙"
                                   FontFamily="Segoe UI Symbol"
                                   FontSize="21"
                                   Foreground="#F5D992"/>

                        <TextBlock Text="遊戲設定"
                                   Margin="8,0,0,0"
                                   FontFamily="{StaticResource TitleFont}"
                                   FontSize="15"
                                   Foreground="#FFF9EA"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                </Button>


                <!-- 最新消息 -->

                <Button Grid.Column="1"
                        Style="{StaticResource MenuButton}">

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="▤"
                                   FontSize="19"
                                   Foreground="#F5D992"/>

                        <TextBlock Text="最新消息"
                                   Margin="8,0,0,0"
                                   FontFamily="{StaticResource TitleFont}"
                                   FontSize="15"
                                   Foreground="#FFF9EA"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                </Button>


                <Border Grid.Column="2"
                        Width="1"
                        Height="38"
                        Background="#70889AA7"
                        VerticalAlignment="Center"/>


                <!-- Client 狀態 -->

                <StackPanel Grid.Column="3"
                            VerticalAlignment="Center"
                            Margin="20,0,0,0">

                    <TextBlock Text="CLIENT STATUS"
                               FontFamily="Georgia"
                               FontSize="9"
                               Foreground="#91A4B1"/>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,5,0,0">

                        <Ellipse Width="9"
                                 Height="9"
                                 Fill="#4BE38B"
                                 VerticalAlignment="Center"
                                 Margin="0,0,8,0"/>

                        <TextBlock x:Name="ClientStatusText"
                                   Text="正在驗證遊戲..."
                                   FontFamily="{StaticResource UiFont}"
                                   FontSize="13"
                                   Foreground="#FFF9EE"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                </StackPanel>


                <!-- Endpoint -->

                <StackPanel Grid.Column="4"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,20,0">

                    <TextBlock Text="REWORK"
                               FontFamily="Georgia"
                               FontSize="9"
                               Foreground="#9BAAB4"
                               HorizontalAlignment="Right"/>

                    <TextBlock Text="52.63.34.162 : 6001"
                               FontFamily="Georgia"
                               FontSize="11"
                               Foreground="#EDF1F3"
                               Margin="0,4,0,0"/>

                </StackPanel>


                <!-- 開始遊戲 -->

                <Button x:Name="StartGameButton"
                        Grid.Column="5"
                        Width="275"
                        Height="75"
                        VerticalAlignment="Center"
                        Style="{StaticResource StartButton}"
                        Click="StartGame_Click">

                    <StackPanel>

                        <TextBlock Text="開始遊戲"
                                   FontFamily="{StaticResource TitleFont}"
                                   FontSize="27"
                                   FontWeight="Bold"
                                   Foreground="#422613"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="START GAME"
                                   FontFamily="Georgia"
                                   FontSize="9"
                                   Foreground="#71451F"
                                   HorizontalAlignment="Center"
                                   Margin="0,-2,0,0"/>

                    </StackPanel>

                </Button>

            </Grid>

        </Border>

    </Grid>
</Window>
