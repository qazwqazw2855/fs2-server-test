<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\God2.ClassicServer.Domain\God2.ClassicServer.Domain.csproj" />
    <ProjectReference Include="..\God2.ClassicServer.Application\God2.ClassicServer.Application.csproj" />
    <ProjectReference Include="..\God2.ClassicServer.Protocol\God2.ClassicServer.Protocol.csproj" />
    <ProjectReference Include="..\God2.ClassicServer.Persistence\God2.ClassicServer.Persistence.csproj" />
    <ProjectReference Include="..\God2.ClassicServer.Infrastructure\God2.ClassicServer.Infrastructure.csproj" />
    <ProjectReference Include="..\God2.ClassicServer.Runtime\God2.ClassicServer.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\database\schema\**\*.*">
      <Link>database\schema\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\localization\**\*.*">
      <Link>localization\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <PropertyGroup>
    <AssemblyName>God2 Classic Server</AssemblyName>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <Target Name="CopyRuntimeData" AfterTargets="Build">
    <RemoveDir Directories="$(OutDir)config" Condition="Exists('$(OutDir)config')" />
    <RemoveDir Directories="$(OutDir)database" Condition="Exists('$(OutDir)database')" />
    <RemoveDir Directories="$(OutDir)localization" Condition="Exists('$(OutDir)localization')" />
    <RemoveDir Directories="$(OutDir)runtime\protocol-evidence" Condition="Exists('$(OutDir)runtime\protocol-evidence')" />
    <ItemGroup>
      <_RuntimeSchema Include="..\..\database\schema\**\*.*" />
      <_RuntimeLocalization Include="..\..\localization\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_RuntimeSchema)" DestinationFiles="@(_RuntimeSchema->'$(OutDir)database\schema\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(_RuntimeLocalization)" DestinationFiles="@(_RuntimeLocalization->'$(OutDir)localization\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

</Project>
